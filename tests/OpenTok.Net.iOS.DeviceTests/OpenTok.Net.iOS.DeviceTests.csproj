<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Which target framework to exercise. A property of our own rather than overriding
      TargetFramework directly on the command line, which breaks restore.
    -->
    <OpenTokDeviceTargetFramework Condition=" '$(OpenTokDeviceTargetFramework)' == '' ">net9.0-ios18.0</OpenTokDeviceTargetFramework>
    <TargetFramework>$(OpenTokDeviceTargetFramework)</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <CheckEolWorkloads>false</CheckEolWorkloads>

    <ApplicationId>com.sbokatuk.opentok.ios.devicetests</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>

    <!-- Matches OTXCFramework's own minimum — see src/OpenTok.Net.iOS/OpenTok.Net.iOS.csproj. -->
    <SupportedOSPlatformVersion>13.0</SupportedOSPlatformVersion>

    <!--
      The checks report through stdout, which the runner script streams back with `simctl launch`
      in console-pty mode. Quietening the Mono logger keeps that stream to the test output rather
      than runtime chatter.
    -->
    <MtouchExtraArgs>--setenv=MONO_LOG_LEVEL=error</MtouchExtraArgs>

    <!--
      The interpreter, explicitly — same reasoning as the sibling Net.Agora.iOS repository's
      device tests: the .NET 9 iOS SDK JITs a Debug simulator build, the .NET 8 one puts the
      runtime in aot-only mode for the same command line and dies on the first assembly it has no
      AOT image for. Setting it for every band keeps the matrix legs comparable.
    -->
    <UseInterpreter>true</UseInterpreter>
  </PropertyGroup>

  <!--
    Deliberately consumes the packed NuGet from ./artifacts rather than a ProjectReference, so it
    exercises the artifact that actually gets published — the merged three-target-framework
    package out of build/merge-packages.py, native payload and all, which a ProjectReference
    would prove nothing about. See NuGet.config for the local feed.
  -->
  <PropertyGroup>
    <OpenTokDevicePackageVersion Condition=" '$(OpenTokDevicePackageVersion)' == '' ">$(VersionPrefix)</OpenTokDevicePackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Exact version, in brackets — a bare version is a *minimum* to NuGet, so a build missing from
      artifacts/ would silently resolve from nuget.org instead of failing the restore.
    -->
    <PackageReference Include="OpenTok.Net.iOS" Version="[$(OpenTokDevicePackageVersion)]" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Both None (the item type) and LogicalName="Info.plist" (the metadata) are required: this is
      a plain iOS SDK project, not MAUI, and _DetectAppManifest locates a manifest by LogicalName
      rather than by path.
    -->
    <None Include="Info.plist" LogicalName="Info.plist" />
  </ItemGroup>

</Project>
