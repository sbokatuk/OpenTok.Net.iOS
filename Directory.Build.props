<Project>

  <PropertyGroup>
    <!--
      Package version is <SDK version>.<binding revision>, e.g. 2.34.1.1 — the same scheme the
      Net.Agora.iOS repository uses for its own packages, and the scheme the original
      OpenTok.Net.iOS package already shipped under (see sbokatuk/OpenTok.Net's changeversions.sh).

      OpenTokIosVersion pins the vendored SDK: OTXCFramework 2.35.1, fetched from the URL its own
      CocoaPods podspec declares (https://cdn.cocoapods.org/Specs/e/7/8/OTXCFramework/2.35.1/
      OTXCFramework.podspec.json -> source.http) rather than through CocoaPods itself — this is a
      binding project, not a pod consumer. See build/fetch-opentok.sh.

      2.35.1 is a small header delta over 2.34.1 (scalability-mode setter on OTPublisherKit, one
      new publisher error code, the deprecated OTVideoFrame setMetadata:error: removed), but one
      consequence beyond the version string is breaking:

        * The pod's own floor moved from iOS 15.0 to iOS 17.0 ("platforms": {"ios": "17.0"}, and
          MinimumOSVersion 17.0 in both xcframeworks' Info.plist), so SupportedOSPlatformVersion
          moves with it in every project here. An app still targeting iOS 15 or 16 cannot take this
          package; 2.34.1.2 is the last one that runs there.

      The 2.34.1 bump before it was the larger one — floor 13.0 to 15.0, OTSubscriberKit bound as
      its own type, delegate protocols typed with the header's own OTPublisherKit/OTSubscriberKit
      parameters, OTVideoViewScaleBehavior's members no longer named "t" and "ll". See
      docs/release-notes for each release's full list.

      The fourth component belongs to this repository and advances when the binding changes while
      the native artifact stays put.

      It restarts at 1 on every SDK bump — as it did at 2.34.1, which it could NOT do while the
      first three components were still 2.27.1. The predecessor monorepo (sbokatuk/OpenTok.Net) published OpenTok.Net.iOS up to
      2.27.1.701 on nuget.org under this exact package ID —
      https://api.nuget.org/v3-flatcontainer/opentok.net.ios/index.json lists ten versions ending
      2.27.1.701, plus the prerelease 2.27.1.702-beta.1.1 (re-verified 2026-07-28). NuGet resolves
      the highest version regardless of which repository published it, so while this repository was
      also on SDK 2.27.1 its revision had to sort above 701 — hence the 702 that used to sit here.
      Moving the SDK to 2.34.1 lifted the first three components clear of every published version,
      so 2.34.1.1 already sorted above all of them and the counter was free to start over; 2.35.1.1
      sorts above 2.34.1.2 for the same reason.

      The rule that produced 702 still applies, though: before lowering any component, check that
      URL. A version that does not sort above what is already on nuget.org makes this package
      permanently invisible to `dotnet add package`.
    -->
    <OpenTokIosVersion>2.35.1</OpenTokIosVersion>
    <OpenTokBindingRevision>1</OpenTokBindingRevision>
    <VersionPrefix>$(OpenTokIosVersion).$(OpenTokBindingRevision)</VersionPrefix>

    <Authors>s.bokatuk</Authors>
    <Company>s.bokatuk</Company>
    <Copyright>Copyright © s.bokatuk</Copyright>
    <PackageProjectUrl>https://github.com/sbokatuk/OpenTok.Net.iOS</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sbokatuk/OpenTok.Net.iOS</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!--
      MIT covers the binding code in this repository. Vonage's own OpenTok SDK is distributed
      under its own commercial SDK licence (see OTXCFramework.podspec's "license" -> "text"), so —
      same reasoning as Net.Agora.iOS's Agora licence note — no second licence expression is added
      here; nothing is claimed about Vonage's own terms.
    -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition=" '$(GITHUB_ACTIONS)' == 'true' ">true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
